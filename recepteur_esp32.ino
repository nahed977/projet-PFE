//    FONCTION ENVOI COMMANDE IR (via Queue)


void sendIRCommand(uint8_t type, int value) {
  IRCommand cmd = {type, value};
  if (xQueueSend(irCommandQueue, &cmd, pdMS_TO_TICKS(100)) != pdTRUE) {
    Serial.println("[IR] Queue pleine!");
  }
}






//   CALLBACK ESP-NOW (Réception données émetteur)


void onDataRecv(const esp_now_recv_info *info, const uint8_t *data, int len) {
  if (len == sizeof(struct_message)) {
    struct_message receivedData;
    memcpy(&receivedData, data, sizeof(receivedData));

    if (xSemaphoreTake(dataMutex, pdMS_TO_TICKS(100)) == pdTRUE) {
      systemState.remoteTemp = receivedData.temperature;
      systemState.remoteHumidity = receivedData.humidite;
      systemState.remoteDataTimestamp = millis();
      systemState.remoteDataValid = true;
      xSemaphoreGive(dataMutex);

      Serial.printf("[ESP-NOW] Recu: T=%.1f°C H=%.1f%% ts=%lu\n",
                    receivedData.temperature, receivedData.humidite, receivedData.timestamp);
    }
  }
}


//  AFFICHAGE LCD


void updateLCDDisplay() {
  lcd.clear();

  // Ligne 0: État AC et température
  if (systemState.acPowerState) {
    lcd.print(0, 0, "ON");
    const char* modes[] = {"Auto", "Cool", "Dry", "Heat", "Fan"};
    if (systemState.currentMode >= 0 && systemState.currentMode <= 4) {
      lcd.print(4, 0, modes[systemState.currentMode]);
    }
  } else {
    lcd.print(0, 0, "OFF");
  }
  lcd.print(9, 0, String(systemState.avgTemp, 1) + "c");

  // Ligne 1: Température consigne et humidité
  lcd.print(0, 1, "Set:" + String(systemState.currentTemp) + "C");
  lcd.print(9, 1, String((int)systemState.avgHumidity) + "%");

  // indicateur mode auto
  if (systemState.autoModeActive) {
    lcd.print(14, 1, "A");
  }
}


