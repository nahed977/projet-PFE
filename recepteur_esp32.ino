  //Blynk.virtualWrite(V13, systemState.backupPowerState);
}


//   NOTIFICATIONS ET ALERTES


void checkAndNotify() {
  unsigned long now = millis();
  if (now - systemState.lastNotification < NOTIFICATION_INTERVAL) return;

  
  // Température haute > 25°C
 if (systemState.avgTemp > TEMP_MAX) {
    if (!systemState.alertTempHighSent) {
      Blynk.logEvent("temp_high", String("🔺 Température élevée: ") + String(systemState.avgTemp, 1) + "°c");
      systemState.alertTempHighSent = true;
      systemState.lastNotification = now;
      Serial.println("[ALERTE] Température haute!");
    }
  } else {
    systemState.alertTempHighSent = false;
  }

  // Température basse < 20°C
  if (systemState.avgTemp < TEMP_MIN) {
    if (!systemState.alertTempLowSent) {
      Blynk.logEvent("temp_low", String("❄️ Température basse: ") + String(systemState.avgTemp, 1) + "°c");
      systemState.alertTempLowSent = true;
      systemState.lastNotification = now;
      Serial.println("[ALERTE] Température basse!");
    }
  } else {
    systemState.alertTempLowSent = false;
  }

  // Humidité haute > 75%
  if (systemState.avgHumidity > HUMIDITY_MAX) {
    if (!systemState.alertHumidityHighSent) {
      Blynk.logEvent("humidity_high", String("🌊 Humidité élevée: ") + String(systemState.avgHumidity, 1));
      systemState.alertHumidityHighSent = true;
      systemState.lastNotification = now;
      Serial.println("[ALERTE] Humidité haute!");
    }
  } else {
    systemState.alertHumidityHighSent = false;
  }

  // Humidité basse < 25%
  if (systemState.avgHumidity < HUMIDITY_MIN) {
    if (!systemState.alertHumidityLowSent) {
      Blynk.logEvent("humidity_low", String("🟥 Humidité basse: ") + String(systemState.avgHumidity, 1));
      systemState.alertHumidityLowSent = true;
      systemState.lastNotification = now;
      Serial.println("[ALERTE] Humidité basse!");
    }
  } else {
    systemState.alertHumidityLowSent = false;
  }
}


void controleHumidite(float h) {

  // 1. Si humidité > 75% -> Mode DRY
  if (h > HUMIDITY_MAX && systemState.currentMode != 2) {
    Serial.println("[CTRL] Humidité > 75% -> Activation MODE DRY");
    if (!systemState.acPowerState) {
      sendIRCommand(0, 1);
      systemState.acPowerState = true;
      vTaskDelay(pdMS_TO_TICKS(500));
    }
    sendIRCommand(1, 2);
    systemState.currentMode = 2;
  }

  // 2. Si humidité < 25% -> Contrôler selon température
  else if (h < HUMIDITY_MIN) {
    Serial.println("[CTRL] Humidité < 25% -> Vérification température");
    if (systemState.avgTemp > TEMP_MAX) {
      sendIRCommand(1, 1); // COOL
      systemState.currentMode = 1;
    } else if (systemState.avgTemp < TEMP_MIN) {
      sendIRCommand(1, 3); // HEAT
      systemState.currentMode = 3;
    } else {
      sendIRCommand(1, 4); // FAN
      systemState.currentMode = 4;
    }
  }

  // 3. Si humidité entre 25-75% -> Mode FAN
  else if (systemState.currentMode != 4) {
    Serial.println("[CTRL] Humidité OK -> Mode FAN");
    sendIRCommand(1, 4);
    systemState.currentMode = 4;
  }
}


// CONTRÔLE TEMPÉRATURE


void controleTemperature(float t) {
  // Priorité au contrôle humidité si mode DRY actif
  if (systemState.currentMode == 2) {
    return;
  }

  // Si température > 26°C -> Mode COOL
  if (t > TEMP_MAX && (!systemState.acPowerState || systemState.currentMode != 1)) {
    Serial.println("[CTRL] Température > 26°C -> Activation MODE COOL");

    if (!systemState.acPowerState) {
      sendIRCommand(0, 1); // Power ON
      systemState.acPowerState = true;
      vTaskDelay(pdMS_TO_TICKS(500));
    }

    sendIRCommand(1, 1); // Mode COOL
    systemState.currentMode = 1;
  } 
// Si température < 20°C -> Mode HEAT
  else if (t < TEMP_MIN && (!systemState.acPowerState || systemState.currentMode != 3)) {
    Serial.println("[CTRL] Température < 20°C -> Activation MODE HEAT");

    if (!systemState.acPowerState) {
      sendIRCommand(0, 1); // Power ON
      systemState.acPowerState = true;
      vTaskDelay(pdMS_TO_TICKS(500));
    }
    sendIRCommand(1, 3); // ← AJOUTE ICI
    systemState.currentMode = 3; // ← AJOUTE ICI
  }

    // NOUVEAU : température dans la plage → passer en FAN au lieu d'éteindre
  else if (t >= TEMP_MIN && t <= TEMP_MAX && 
           systemState.acPowerState && 
           systemState.currentMode != 4) {
    Serial.println("[CTRL] Température OK → passage MODE FAN");
    sendIRCommand(1, 4);              // Mode FAN
    systemState.currentMode = 4;
  }
}











//    PUBLICATION MQTT


void publishSensorData() {
  StaticJsonDocument<512> doc;

  doc["device_id"] = "ESP32_AC_001";
  doc["device"] = "esp32-ac-sht31";
  doc["temperature"] = systemState.avgTemp;
  doc["humidity"] = systemState.avgHumidity;
  doc["local_temp"] = systemState.localTemp;
  doc["local_humidity"] = systemState.localHumidity;
  doc["remote_temp"] = systemState.remoteTemp;
  doc["remote_humidity"] = systemState.remoteHumidity;
  doc["ts_ms"] = millis();

  doc["ac_power"] = systemState.acPowerState;
  doc["ac_mode"] = systemState.currentMode;
  doc["ac_temp_set"] = systemState.currentTemp;
  doc["ac_fan_speed"] = systemState.currentSpeed;
  doc["auto_mode"] = systemState.autoModeActive;
  doc["status"] = "ok";

  char payload[512];
  serializeJson(doc, payload);

  if (mqttClient.publish(TOPIC_DATA, payload, false)) {
    Serial.println("[MQTT] Données publiées");
  } else {
    Serial.println("[MQTT] Echec publication");
  }
}
  

//  CALLBACK MQTT


void mqttCallback(char* topic, byte* payload, unsigned int length) {
  char msg[length + 1];
  memcpy(msg, payload, length);
  msg[length] = '\0';

  Serial.printf("[MQTT] Message reçu: %s\n", msg);

  StaticJsonDocument<256> doc;
  if (deserializeJson(doc, msg) == DeserializationError::Ok) {
    bool updated = false;

    if (doc.containsKey("power")) {
      int p = doc["power"];
      sendIRCommand(0, p);
      systemState.acPowerState = p;
      updated = true;
    }

    if (doc.containsKey("temperature")) {
      int t = doc["temperature"];
      if (t >= 16 && t <= 30) {
        systemState.currentTemp = t;
        sendIRCommand(2, t);
        updated = true;
      }
    }

    if (doc.containsKey("mode")) {
      int m = doc["mode"];
      if (m >= 0 && m <= 4) {
        systemState.currentMode = m;
        sendIRCommand(1, m);
        updated = true;
      }
    }

    if (doc.containsKey("fan_speed")) {
      int s = doc["fan_speed"];
      if (s >= 0 && s <= 3) {
        systemState.currentSpeed = s;
        sendIRCommand(3, s);
        updated = true;
      }
    }

    if (doc.containsKey("auto_mode")) {
      systemState.autoModeActive = doc["auto_mode"];
      updated = true;
    }

    if (updated) {
      updateLCDDisplay();
      updateBlynkWidgets();
    }
  }
}


//  CONNEXION MQTT


void connectMQTT() {
  if (mqttClient.connected()) return;

  Serial.println("[MQTT] Connexion...");

  String clientId = "ESP32-RX-" + String((uint32_t)ESP.getEfuseMac(), HEX);

  if (mqttClient.connect(clientId.c_str())) {
