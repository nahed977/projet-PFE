//   TÂCHE 1: SensorTask - Priorité 2

void sensorTask(void *parameter) {
  TickType_t lastWakeTime = xTaskGetTickCount();

  Serial.println("[SensorTask] Démarré");

  for (;;) {
    systemState.sensorTaskCounter++;
    Serial.println("\n[SensorTask] === Début cycle acquisition ===");

    float t_local = NAN;
    float h_local = NAN;

    // Lecture capteur local SHT31 avec protection mutex I2C
    if (xSemaphoreTake(i2cMutex, pdMS_TO_TICKS(1000)) == pdTRUE) {
      t_local = sht31.readTemperature();
      h_local = sht31.readHumidity();
      xSemaphoreGive(i2cMutex);
    }

    // Vérification lecture réussie
    if (!isnan(t_local) && !isnan(h_local)) {
      Serial.printf("[SensorTask] Local: T=%.1f°C H=%.1f%%\n", t_local, h_local);

      // Mise à jour avec protection mutex
      if (xSemaphoreTake(dataMutex, pdMS_TO_TICKS(100)) == pdTRUE) {
        systemState.localTemp = t_local;
        systemState.localHumidity = h_local;

        // Calcul des moyennes
        if (systemState.remoteDataValid &&
            (millis() - systemState.remoteDataTimestamp < DATA_VALID_TIMEOUT)) {
          // Données distantes valides -> moyenne
          systemState.avgTemp = (t_local + systemState.remoteTemp) / 2.0;
          systemState.avgHumidity = (h_local + systemState.remoteHumidity) / 2.0;
          Serial.printf("[SensorTask] Moyenne (2 capteurs): T=%.1f°C H=%.1f%%\n",
                        systemState.avgTemp, systemState.avgHumidity);
        } else {
          // Pas de données distantes valides -> utiliser local uniquement
          systemState.avgTemp = t_local;
          systemState.avgHumidity = h_local;
          Serial.println("[SensorTask] Données distantes expirées, utilisation local seul");
        }

        xSemaphoreGive(dataMutex);

        // Publier dans BroadcastQueue
        AveragedData avgData;
        avgData.temperature = systemState.avgTemp;
        avgData.humidity = systemState.avgHumidity;
        avgData.timestamp = millis();
        avgData.isValid = true;

        xQueueOverwrite(BroadcastQueue, &avgData);
        Serial.println("[SensorTask] Données publiées dans BroadcastQueue");
      }
    } else {
      // Erreur de lecture
      Serial.println("[SensorTask] ERREUR lecture capteur local!");

      // Tentative reset capteur
      if (xSemaphoreTake(i2cMutex, pdMS_TO_TICKS(1000)) == pdTRUE) {
        sht31.reset();
        xSemaphoreGive(i2cMutex);
      }
    }

    Serial.println("[SensorTask] === Fin cycle ===\n");

    // Attente 10 secondes
    vTaskDelayUntil(&lastWakeTime, pdMS_TO_TICKS(SENSOR_READ_INTERVAL));
  }
}


//   TÂCHE 2: ControlTask - Priorité 3


void controlTask(void *parameter) {
  TickType_t lastWakeTime = xTaskGetTickCount();
  AveragedData currentData;

  Serial.println("[ControlTask] Démarré");

  for (;;) {
    systemState.controlTaskCounter++;

    // Lire données depuis BroadcastQueue
    if (xQueuePeek(BroadcastQueue, &currentData, 0) == pdTRUE) {

      // Vérifier validité des données (timestamp < 5 min)
      if (currentData.isValid && (millis() - currentData.timestamp < DATA_VALID_TIMEOUT)) {

        Serial.println("\n[ControlTask] === Analyse des données ===");
        Serial.printf("[ControlTask] T=%.1f°C H=%.1f%%\n", currentData.temperature, currentData.humidity);

        // Mode automatique activé ?
        if (systemState.autoModeActive) {
          Serial.println("[ControlTask] Mode AUTO actif");

          

          // Contrôle humidité (prioritaire)
          controleHumidite(currentData.humidity);

          // Contrôle température
          controleTemperature(currentData.temperature);

          // Notifications
          checkAndNotify();
        } else {
          Serial.println("[ControlTask] Mode AUTO inactif");
        }

        Serial.println("[ControlTask] === Fin analyse ===\n");

      } else {
        Serial.println("[ControlTask] Données périmées ou invalides");
      }
    }

    // Attente 10 secondes
    vTaskDelayUntil(&lastWakeTime, pdMS_TO_TICKS(CONTROL_CHECK_INTERVAL));
  }
}


//   TÂCHE 3: SupervisionTask - Priorité 1


void supervisionTask(void *parameter) {
  TickType_t lastWakeTime = xTaskGetTickCount();

  Serial.println("[SupervisionTask] Démarré");

  for (;;) {
    systemState.supervisionTaskCounter++;
    unsigned long now = millis();

    // Vérification connexion WiFi
    if (WiFi.status() != WL_CONNECTED) {
      Serial.println("[SupervisionTask] WiFi déconnecté, reconnexion...");
      WiFi.reconnect();
    }

    // Vérification connexion MQTT
    if (!mqttClient.connected()) {
      connectMQTT();
    }
    mqttClient.loop();

    // Maintien connexion Blynk
    //Blynk.run();
    if (!Blynk.connected()) {
  Blynk.connect(1000);
} else {
  Blynk.run();
}

    // Mise à jour Blynk (toutes les 2 secondes)
    if (now - systemState.lastBlynkUpdate >= BLYNK_UPDATE_INTERVAL) {
      updateBlynkWidgets();
      updateLCDDisplay();
      systemState.lastBlynkUpdate = now;
    }

    // Publication MQTT (toutes les 10 secondes)
    if (now - systemState.lastMqttPublish >= MQTT_PUBLISH_INTERVAL) {
      if (mqttClient.connected()) {
        publishSensorData();
      }
      systemState.lastMqttPublish = now;
    }

    // Attente courte pour réactivité réseau
    vTaskDelayUntil(&lastWakeTime, pdMS_TO_TICKS(1000));
  }
}


//   TÂCHE 4: WatchdogTask - Priorité 0


void watchdogTask(void *parameter) {
  TickType_t lastWakeTime = xTaskGetTickCount();

  Serial.println("[WatchdogTask] Démarré");

  // Initialiser les compteurs
  systemState.lastSensorCount = 0;
  systemState.lastControlCount = 0;
  systemState.lastSupervisionCount = 0;

  for (;;) {
    Serial.println("\n[WatchdogTask] === Vérification système ===");

    bool systemOK = true;

    // Vérification SensorTask
    if (systemState.sensorTaskCounter == systemState.lastSensorCount) {
      Serial.println("[WatchdogTask] ALERTE: SensorTask bloquée!");
      systemOK = false;
    }
    systemState.lastSensorCount = systemState.sensorTaskCounter;

    // Vérification ControlTask
    if (systemState.controlTaskCounter == systemState.lastControlCount) {
      Serial.println("[WatchdogTask] ALERTE: ControlTask bloquée!");
      systemOK = false;
    }
    systemState.lastControlCount = systemState.controlTaskCounter;

    // Vérification SupervisionTask
    if (systemState.supervisionTaskCounter == systemState.lastSupervisionCount) {
      Serial.println("[WatchdogTask] ALERTE: SupervisionTask bloquée!");
      systemOK = false;
    }
    systemState.lastSupervisionCount = systemState.supervisionTaskCounter;

    // Vérification mémoire
    uint32_t freeHeap = ESP.getFreeHeap();
    Serial.printf("[WatchdogTask] Mémoire libre: %d bytes\n", freeHeap);

    if (freeHeap < 10000) {
      Serial.println("[WatchdogTask] ALERTE: Mémoire faible!");
      systemOK = false;
    }

    // Actions en cas de problème
    if (!systemOK) {
      systemState.watchdogResets++;
      Serial.printf("[WatchdogTask] Problèmes détectés! Resets: %d\n", systemState.watchdogResets);

      // Si trop de resets -> redémarrage
      if (systemState.watchdogResets >= 3) {
        Serial.println("[WatchdogTask] REDÉMARRAGE SYSTÈME!");
        delay(1000);
        ESP.restart();
      }
    } else {
      Serial.println("[WatchdogTask] Système OK");
      systemState.watchdogResets = 0; // Reset compteur si tout va bien
    }

    // Afficher statistiques
    Serial.printf("[WatchdogTask] Compteurs - Sensor:%d Control:%d Supervision:%d\n",
                  systemState.sensorTaskCounter,
                  systemState.controlTaskCounter,
                  systemState.supervisionTaskCounter);

    Serial.println("[WatchdogTask] === Fin vérification ===\n");

    // Attente 30 secondes
    vTaskDelayUntil(&lastWakeTime, pdMS_TO_TICKS(WATCHDOG_CHECK_INTERVAL));
  }
}


//   TÂCHE 5: IRTask - Priorité 3


void irTask(void *parameter) {
  IRCommand cmd;

  Serial.println("[IRTask] Démarré");

  for (;;) {
    // Attendre commande dans la queue
    if (xQueueReceive(irCommandQueue, &cmd, portMAX_DELAY) == pdTRUE) {

      // Respecter le cooldown IR
      unsigned long now = millis();
      if (now - systemState.lastIRCommand < IR_COOLDOWN) {
        vTaskDelay(pdMS_TO_TICKS(IR_COOLDOWN - (now - systemState.lastIRCommand)));
      }

      Serial.printf("[IRTask] Envoi commande: type=%d value=%d\n", cmd.type, cmd.value);

      switch(cmd.type) {
        case 0: // Power
          if (cmd.value) {
            irsend.sendRaw(powerON, 211, 38);
          } else {
            irsend.sendRaw(powerOFF, 211, 38);
          }
          break;

        case 1: // Mode
          switch(cmd.value) {
            case 0: irsend.sendRaw(modeAuto, 211, 38); break;
            case 1: irsend.sendRaw(modeCool, 211, 38); break;
            case 2: irsend.sendRaw(modeDry, 211, 38); break;
            case 3: irsend.sendRaw(modeHeat, 211, 38); break;
            case 4: irsend.sendRaw(modeFan, 211, 38); break;
          }
          break;

        case 2: // Température
          sendTempIR(cmd.value);
          break;

        case 3: // Vitesse ventilateur
          switch(cmd.value) {
            
            case 1: irsend.sendRaw(speedLow, 211, 38); break;
            case 2: irsend.sendRaw(speedMedium, 211, 38); break;
            case 3: irsend.sendRaw(speedHigh, 211, 38); break;
          }
          break;

        case 4: // Lumière
          irsend.sendRaw(light, 211, 38);
          break;
      }

      systemState.lastIRCommand = millis();
    }
  }
}


//    HANDLERS BLYNK


// V0: Power ON/OFF
BLYNK_WRITE(V0) {
  int value = param.asInt();
  sendIRCommand(0, value);
  systemState.acPowerState = value;
  updateLCDDisplay();
  Serial.printf("[Blynk] Power: %s\n", value ? "ON" : "OFF");
}

// V1: Light
BLYNK_WRITE(V1) {
  if (param.asInt() == 1) {
    sendIRCommand(4, 0);
    Blynk.virtualWrite(V1, 0);
    Serial.println("[Blynk] Light toggle");
  }
}

// V2: Temp +
BLYNK_WRITE(V2) {
  if (param.asInt() && systemState.currentTemp < 30) {
    systemState.currentTemp++;
    sendIRCommand(2, systemState.currentTemp);
    updateLCDDisplay();
    Serial.printf("[Blynk] Temp+: %d°C\n", systemState.currentTemp);
  }
  Blynk.virtualWrite(V2, 0);
}

// V3: Temp -
BLYNK_WRITE(V3) {
  if (param.asInt() && systemState.currentTemp > 16) {
    systemState.currentTemp--;
    sendIRCommand(2, systemState.currentTemp);
    updateLCDDisplay();
    Serial.printf("[Blynk] Temp-: %d°C\n", systemState.currentTemp);
  }
  Blynk.virtualWrite(V3, 0);
}

// V4: Mode
BLYNK_WRITE(V4) {
  if (param.asInt()) {
    systemState.currentMode++;
    if (systemState.currentMode > 4) systemState.currentMode = 0;
    sendIRCommand(1, systemState.currentMode);
    updateLCDDisplay();

    const char* modes[] = {"Auto", "Cool", "Dry", "Heat", "Fan"};
    Serial.printf("[Blynk] Mode: %s\n", modes[systemState.currentMode]);
  }
  Blynk.virtualWrite(V4, 0);
}

// V5: Fan Speed
BLYNK_WRITE(V5) {
  if (param.asInt()) {
    systemState.currentSpeed++;
    if (systemState.currentSpeed > 3) systemState.currentSpeed = 0;
    sendIRCommand(3, systemState.currentSpeed);
    updateLCDDisplay();

    const char* speeds[] = {"Auto", "Low", "Medium", "High"};
    Serial.printf("[Blynk] Fan: %s\n", speeds[systemState.currentSpeed]);
  }
  Blynk.virtualWrite(V5, 0);
}

// V11: Auto Mode
BLYNK_WRITE(V11) {
  systemState.autoModeActive = param.asInt();
  updateLCDDisplay();
  Serial.printf("[Blynk] Auto Mode: %s\n", systemState.autoModeActive ? "ON" : "OFF");
}



void setup() {
  Serial.begin(115200);
  delay(1000);

  Serial.println("\n");
  Serial.println("  ================================  ");
  Serial.println("  SYSTÈME DE CONTRÔLE ENVIRONNEMENTAL  ");
  Serial.println("  Module Récepteur - FreeRTOS  ");
  Serial.println("  Version 3.0  ");
  Serial.println("  ================================  ");
  Serial.println();

  // ===== 1. Initialisation I2C et capteur SHT31 =====
  Serial.println("[INIT] Initialisation I2C et SHT31...");
  Wire.begin(I2C_SDA, I2C_SCL);

  if (!sht31.begin(0x44)) {
    Serial.println("[INIT] ERREUR: SHT31 non détecté!");
  } else {
    Serial.println("[INIT] SHT31 OK");
  }

  // ===== 2. Initialisation IR =====
  Serial.println("[INIT] Initialisation émetteur IR...");
  irsend.begin();
  //irsend_backup.begin(); // ← NOUVEAU
  //Serial.println("[INIT] IR OK");

  // ===== 3. Connexion WiFi =====
  connectWifi();

  // ===== 4. Initialisation ESP-NOW =====
  Serial.println("[INIT] Initialisation ESP-NOW...");
  if (esp_now_init() == ESP_OK) {
    esp_now_register_recv_cb(onDataRecv);
    Serial.println("[INIT] ESP-NOW OK");
  } else {
    Serial.println("[INIT] ERREUR ESP-NOW!");
  }

  // ===== 5. Configuration Blynk =====
  Serial.println("[INIT] Configuration Blynk...");
  Blynk.config(BLYNK_AUTH_TOKEN, "blynk.cloud", 80);
  Blynk.connect(3000);
  Serial.println("[INIT] Blynk OK");

  // ===== 6. Configuration MQTT =====
  Serial.println("[INIT] Configuration MQTT...");
  mqttClient.setServer(MQTT_BROKER, MQTT_PORT);
  mqttClient.setCallback(mqttCallback);
  mqttClient.setBufferSize(512);
  mqttClient.setKeepAlive(60);
  connectMQTT();

  // ===== 7. Création objets FreeRTOS =====
  Serial.println("[INIT] Création objets FreeRTOS...");

  // Queues
  BroadcastQueue = xQueueCreate(1, sizeof(AveragedData));
  irCommandQueue = xQueueCreate(10, sizeof(IRCommand));

  // Mutex
  dataMutex = xSemaphoreCreateMutex();
  i2cMutex = xSemaphoreCreateMutex();

  if (BroadcastQueue == NULL || irCommandQueue == NULL ||
      dataMutex == NULL || i2cMutex == NULL) {
    Serial.println("[INIT] ERREUR création objets FreeRTOS!");
  } else {
    Serial.println("[INIT] Objets FreeRTOS OK");
  }

  // ===== 8. Création des tâches FreeRTOS =====
  Serial.println("[INIT] Création des tâches FreeRTOS...");
  
 systemState.autoModeActive = true;

  // controlTask - Priorité 3 (haute)
  xTaskCreatePinnedToCore(
    controlTask,
    "ControlTask",
    4096,
    NULL,
    3,
    &controlTaskHandle,
    0
  );

  // SensorTask - Priorité 2
  xTaskCreatePinnedToCore(
    sensorTask,
    "SensorTask",
    4096,
    NULL,
    2,
    &sensorTaskHandle,
    0
  );

  // SupervisionTask - Priorité 1
  xTaskCreatePinnedToCore(
    supervisionTask,
    "SupervisionTask",
    8192,
    NULL,
    1,
    &supervisionTaskHandle,
    1
  );

// IRTask - Priorité 3
xTaskCreatePinnedToCore(
  irTask,
  "IRTask",
  4096,
  NULL,
  3,
  &irTaskHandle,
  1
);

xTaskCreatePinnedToCore(
  watchdogTask,
  "WatchdogTask",
  4096,
  NULL,
  0,
  &watchdogTaskHandle,
  0
);

























  // ===== Fin initialisation =====
  Serial.println();
  Serial.println("  ================================  ");
  Serial.println("         SYSTÈME OPÉRATIONNEL       ");
  Serial.println("  ================================  ");
  Serial.println();

  // Mise à jour initiale affichage
  updateLCDDisplay();
}


