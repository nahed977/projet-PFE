//  STRUCTURES DE DONNEES


//  Structure compatible avec l'émetteur 
typedef struct struct_message {
  float temperature;
  float humidite;
  unsigned long timestamp;
} struct_message;

//  Structure pour commandes IR 
typedef struct { 
  uint8_t type;   // 0=power , 1=mode, 2=temp, 3=speed, 4=light
  int value;
} IRCommand;

//  Structure pour BroadcastQueue
typedef struct {
  float temperature;
  float humidity;
  unsigned long timestamp;
  bool isValid;
} AveragedData;

// État du système
struct SystemState {
  // Données capteurs
  float localTemp = 0;
  float localHumidity = 0;
  float remoteTemp = 0;
  float remoteHumidity = 0;
  float avgTemp = 0;
  float avgHumidity = 0;
  bool remoteDataValid = false;
  unsigned long remoteDataTimestamp = 0;

  // État climatiseur
  bool acPowerState = false;
  int currentMode = 1;  // 0=Auto, 1=Cool, 2=Dry, 3=Heat, 4=Fan
  int currentTemp = 23;
  int currentSpeed = 0; // 0=Auto, 1=Low, 2=Med, 3=High
  bool autoModeActive = false;




  // Alertes
  bool alertTempHighSent = false;
  bool alertTempLowSent = false;
  bool alertHumidityHighSent = false;
  bool alertHumidityLowSent = false;

  // Timestamps
  unsigned long lastIRCommand = 0;
  unsigned long lastBlynkUpdate = 0;
  unsigned long lastMqttPublish = 0;
  unsigned long lastNotification = 0;

  // Compteurs watchdog
  volatile uint32_t sensorTaskCounter = 0;
  volatile uint32_t controlTaskCounter = 0;
  volatile uint32_t supervisionTaskCounter = 0;
  uint32_t lastSensorCount = 0;
  uint32_t lastControlCount = 0;
  uint32_t lastSupervisionCount = 0;
  uint32_t watchdogResets = 0;
} systemState;


